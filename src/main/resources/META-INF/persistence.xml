<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="default" transaction-type="JTA">
        <jta-data-source>jdbc/acikartirma</jta-data-source>

        <class>com.acikartirma.acikartirma.entity.User</class>
        <class>com.acikartirma.acikartirma.entity.Product</class>
        <class>com.acikartirma.acikartirma.entity.Bid</class>
        <class>com.acikartirma.acikartirma.entity.Transaction</class>

        <properties>

            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>

            <property name="eclipselink.ddl-generation" value="create-or-extend-tables"/>

            <property name="eclipselink.logging.level" value="FINE"/>
        </properties>
    </persistence-unit>
</persistence>